DATABASE_URL=postgres:///platform?sslmode=disable
LISTEN_ADDR=0.0.0.0:8210

# DB-backed tests skip by default so `go test ./...` passes hermetically — the in-build
# publish gate has no Postgres. Run them with FXTEST_SKIP_DBTESTS=0 in .env.local or the
# shell env; both take precedence over this file.
FXTEST_SKIP_DBTESTS=1
